{
  "name": "Eigo Fuda Video Web App",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Video app preview",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ritwickdey.LiveServer"
      ]
    }
  },
  "postCreateCommand": "echo 'Ready for local web app development. Run: python3 -m http.server 8000'"
}
